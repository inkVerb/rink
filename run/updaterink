#cleanPatchVerno=$(/usr/bin/echo $upgradePatchVerno | /usr/bin/sed -e "s/\.//g")
#PCLdoc="$(/usr/bin/cat <<UPCL
#Patch ${upgradePatchVerno} Changelog:
### Patch Notes Here...
#UPCL
#)"
#/usr/bin/echo "$PCLdoc"
#eval "v$cleanPatchVerno='$(/usr/bin/echo "$PCLdoc")'"
