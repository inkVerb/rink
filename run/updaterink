#!/bin/bash
#inkVerbRunner! verb.ink

# This updates the rink engine the same way verb-update/update upgrades a verber.
## Runners, felt, help, dispatcher, actions.pb, and web UI source are refreshed from GitHub.
## Sequential version patches follow. conf/, ns/, snapshotid/, tmp/, and rinknames are never replaced.
## Do not clone into /opt/rink/rink — that path is the dispatcher file.

# How to use:
## ./updaterink
## rink update rink

# To call a changelog for a specific version: echo "$v09001"

minVerNo="0.90.00"
RinkUpdateOrg="inkverb"
RinkUpdateRepo="rink"

if [ "$(id -u)" -ne 0 ]; then
  /usr/bin/echo "The 'rink' command must be run with sudo or as root."
  exit 0
fi

# Clone first and re-exec the fresh copy so we never overwrite a running script
if [ "${RINK_UPDATE_INNER}" != "1" ]; then
  /usr/bin/rm -rf /opt/rink/u_tmp
  /usr/bin/mkdir -p /opt/rink/u_tmp
  cd /opt/rink/u_tmp || exit 6
  /usr/bin/git clone "https://github.com/${RinkUpdateOrg}/${RinkUpdateRepo}"
  if [ "$?" != "0" ]; then
    /usr/bin/echo "git clone failed, I quit."
    /usr/bin/rm -rf /opt/rink/u_tmp
    exit 4
  fi
  if [ ! -x /opt/rink/u_tmp/${RinkUpdateRepo}/run/updaterink ]; then
    /usr/bin/echo "Cloned tree has no updaterink. I quit."
    /usr/bin/rm -rf /opt/rink/u_tmp
    exit 4
  fi
  export RINK_UPDATE_INNER=1
  /bin/chmod 750 /opt/rink/u_tmp/${RinkUpdateRepo}/run/updaterink
  exec /opt/rink/u_tmp/${RinkUpdateRepo}/run/updaterink
fi

src="/opt/rink/u_tmp/${RinkUpdateRepo}"
if [ ! -d "${src}/run" ]; then
  /usr/bin/echo "Clone missing at ${src}"
  exit 6
fi

## Sample version updater (same skeleton as verb-update/update):
